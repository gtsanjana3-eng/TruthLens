# TruthLens AI backend configuration. Copy to backend/.env and adjust. Never commit real secrets.
APP_ENV=development                 # development | test | production
# Supabase (hosted PostgreSQL): Supabase dashboard -> your project -> Connect -> "Session pooler" -> URI.
# Paste it as-is (replace [YOUR-PASSWORD] with your database password); the app adds the driver + sslmode=require.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tables are created automatically on first start with row-level security ON (Supabase's public API keys can't read them).
# Copy existing local data once with:  .venv\Scripts\python -m scripts.migrate_to_supabase --yes
# Any other PostgreSQL: postgresql+psycopg://truthlens:CHANGE_ME@localhost:5432/truthlens
# SQLite fallback for local development:
# DATABASE_URL=sqlite:///C:/path/to/truthlens.db   (default: backend/data/truthlens.db)
# REQUIRED in production: at least 32 random characters, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Storage (originals are content-addressed + write-protected; previews/artifacts are derived)
# STORAGE_DIR=/srv/truthlens/evidence     (default: backend/data/evidence)
# PREVIEW_DIR=/srv/truthlens/previews     (default: backend/data/previews)
# REPORT_DIR=/srv/truthlens/reports       (default: backend/data/reports)
RETENTION_DAYS=365

# Upload limits
MAX_IMAGE_MB=25
MAX_VIDEO_MB=300
MAX_AUDIO_MB=60
MAX_TEXT_MB=2
MAX_VIDEO_SECONDS=600
MAX_AUDIO_SECONDS=900

# Processing
PROCESS_ISOLATION=true              # decode untrusted media in separate worker processes
ANALYSIS_TIMEOUT_SECONDS=300
WORKER_THREADS=2
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# One validated model per media type (needs requirements-ml.txt). No API keys are required – all models run locally.
ML_ENABLED=true
HF_VIDEO_MODEL=hchcsuim/batch-size16_DFDC_opencv-1FPS_faces-expand50-aligned_unaugmentation
HF_VIDEO_MODEL_REVISION=5c9aa417b1e9118441877de06536b37b25019889
HF_IMAGE_MODEL=haywoodsloan/ai-image-detector-deploy
HF_IMAGE_MODEL_REVISION=4ae1822603cb1ec980c217cfde1ef1b8e0477a16
HF_AUDIO_MODEL=abhishtagatya/wav2vec2-base-960h-itw-deepfake
HF_AUDIO_MODEL_REVISION=cb2350dec8246c67a5924462659c1796214f019f
HF_TEXT_MODEL=fakespot-ai/roberta-base-ai-text-detection-v1
HF_TEXT_MODEL_REVISION=f9cdb14d1f8b105f597d80fa7b56f20c6ea0e9db
# HF_CACHE_DIR=/srv/truthlens/models   (default: backend/data/models)
HF_OFFLINE=false                    # true after `python -m scripts.download_models` to forbid network access
ML_VIDEO_FRAMES=24
ML_TIMEOUT_SECONDS=900
